# ============================================================================
# Nazir Atta Chakki — environment configuration
# Copy this file to `.env` and fill in real values to go live.
# The server runs fine WITHOUT this file (sandbox payment mode).
# ============================================================================

# Port the server listens on
PORT=3000

# "sandbox" (no real money, testable now) | "live" (needs merchant credentials)
PAYMENT_MODE=sandbox

# Secret used to sign/verify payment callbacks
PAYMENT_SIGNING_SECRET=change-this-to-a-long-random-string

# ---- Easypaisa merchant credentials (from your Easypaisa business account) ----
EASYPAISA_STORE_ID=
EASYPAISA_MERCHANT_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk

# ---- JazzCash merchant credentials (from your JazzCash business account) ----
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk
